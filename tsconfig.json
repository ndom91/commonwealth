{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // TypeScript 7 defaults `types` to an empty array. Before it, any installed
    // `@types/*` package was pulled into every program just by being on disk,
    // which is why this line was not needed and also why a stray transitive
    // `@types` package could change what compiled. Naming the one we depend on
    // is the migration; without it every `node:` specifier and every `process`
    // and `Buffer` reads as an undeclared name.
    "types": ["node"]
  }
  // Package tsconfigs extend this base so the server, web app, and shared source
  // agree on strictness without inheriting one another's file lists.
}
