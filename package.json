{
  "name": "commonwealth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "pnpm --filter @commonwealth/mcp-server dev",
    "start": "pnpm --filter @commonwealth/mcp-server start",
    "typecheck": "pnpm --filter @commonwealth/mcp-server typecheck && pnpm --filter @commonwealth/web typecheck",
    "test": "pnpm --filter @commonwealth/mcp-server test && node --import tsx --test 'packages/*/src/**/*.test.ts'",
    "lint": "pnpm biome check",
    "lint:fix": "pnpm run lint --write",
    "format": "biome check .",
    "format:fix": "biome check --write .",
    "migrate": "pnpm --filter @commonwealth/web migrate",
    "db:studio": "pnpm --filter @commonwealth/web db:studio",
    "reindex": "pnpm --filter @commonwealth/web reindex",
    "bench": "pnpm --filter @commonwealth/mcp-server bench"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^24.0.3",
    "tsx": "^4.20.3"
  }
}
