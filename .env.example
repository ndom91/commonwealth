# Paired host/compose values. The bare name is what a process on your machine
# uses (`pnpm dev`); the COMPOSE_ one is what a container uses, where the
# service hostname resolves. Compose reads the COMPOSE_ variable, so setting the
# bare one to a localhost address does not break the containers.
DATABASE_URL=postgres://team_kb:team_kb@localhost:5432/team_kb
COMPOSE_DATABASE_URL=postgres://team_kb:team_kb@postgres:5432/team_kb
EMBEDDING_URL=http://localhost:8080
COMPOSE_EMBEDDING_URL=http://inference:8080
EMBEDDING_MODEL=qwen3-embedding-0.6b-q8_0-370f27d
# Match the selected GGUF model's documented embedding pooling mode.
MODEL_POOLING=last
# Only for asymmetric models, and only correct for the one above. Leave it unset
# for a symmetric model — a stale instruction is worse than none.
EMBEDDING_QUERY_INSTRUCTION=Given a question from a teammate, retrieve passages from the team knowledge base that answer it
CORPUS_PATH=./corpora
COMPOSE_CORPUS_PATH=/app/corpora

# First-boot administrator. The password is used once to sign in and should then
# be replaced from Settings in the web UI — this file is not where it lives
# permanently. Further administrators are added from Settings too, so
# BETTER_AUTH_ALLOW_SIGN_UP can stay off.
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Forwarded client addresses are trusted only behind a proxy that blocks direct
# access to the services. For Cloudflare orange-cloud records, set both headers
# to `cf-connecting-ip` after Traefik trusts Cloudflare's IP ranges.
APP_TRUST_FORWARDED_FOR=false
APP_FORWARDED_IP_HEADER=x-forwarded-for
WEB_TRUST_FORWARDED_FOR=false
WEB_FORWARDED_IP_HEADER=x-forwarded-for

WEB_PORT=3001
HOST_PORT=3000
POSTGRES_PORT=5432
