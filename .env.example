# Paired host/compose values. The bare name is what a process on your machine
# uses (`pnpm dev`); the COMPOSE_ one is what a container uses, where the
# service hostname resolves. Compose reads the COMPOSE_ variable, so setting the
# bare one to a localhost address does not break the containers.
DATABASE_URL=postgres://team_kb:team_kb@localhost:5432/team_kb
COMPOSE_DATABASE_URL=postgres://team_kb:team_kb@postgres:5432/team_kb
OLLAMA_URL=http://localhost:11434
COMPOSE_OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
MARKITDOWN_URL=http://localhost:8000
COMPOSE_MARKITDOWN_URL=http://markitdown:8000

# Where an uploaded file's original bytes are kept, addressed by content hash.
# In compose this is the source_data volume, shared by app and admin. On the
# host it is a local directory, so a document uploaded during `pnpm dev` stores
# its blob outside the volume the containers share. Nothing reads the blob back
# during retrieval — the converted Markdown lives in the database — and each
# revision records the path it used, so the split is visible rather than silent.
SOURCE_STORAGE_PATH=./storage
COMPOSE_SOURCE_STORAGE_PATH=/app/storage
MAX_UPLOAD_BYTES=10000000

BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

ADMIN_PORT=3001
HOST_PORT=3000
POSTGRES_PORT=5432
CADDY_DOMAIN=kb.example.com
