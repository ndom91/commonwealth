# Paired host/compose values. The bare name is what a process on your machine
# uses (`pnpm dev`); the COMPOSE_ one is what a container uses, where the
# service hostname resolves. Compose reads the COMPOSE_ variable, so setting the
# bare one to a localhost address does not break the containers.
DATABASE_URL=postgres://team_kb:team_kb@localhost:5432/team_kb
COMPOSE_DATABASE_URL=postgres://team_kb:team_kb@postgres:5432/team_kb
OLLAMA_URL=http://localhost:11434
COMPOSE_OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b

BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

ADMIN_PORT=3001
HOST_PORT=3000
POSTGRES_PORT=5432
CADDY_DOMAIN=kb.example.com
